# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.mission text eol=lf
*.system text eol=lf
*.cpt text eol=lf
*.spr text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
CMakeLists.txt text eol=lf
.editorconfig text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf

# Binary asset formats
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.ico binary
*.icns binary
*.xpm binary
*.wav binary
*.ogg binary
*.m3u text eol=lf
*.pdf binary
*.bfxm binary
*.bin binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
